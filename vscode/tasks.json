{
    // The Python installer replaces __TRACE32_TOOLKIT_REL__ with this toolkit's actual
    // path relative to the workspace.
    //
    // Flash, Load and RTT are user-facing. The adapter task is hidden and
    // invoked automatically by TRACE32: Attach in launch.json. Building stays
    // independent: add your project's own build tasks alongside these.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "T32: Flash",
            "detail": "Erase + program the existing ELF, load symbols and run; no build",
            "type": "process",
            "command": "__PYTHON_EXECUTABLE__",
            "args": [
                "${workspaceFolder}/__TRACE32_TOOLKIT_REL__/t32.py",
                "flash"
            ],
            "presentation": {
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "T32: Load ELF",
            "detail": "No build/flash: attach PowerView, load symbols from the existing ELF and run",
            "type": "process",
            "command": "__PYTHON_EXECUTABLE__",
            "args": [
                "${workspaceFolder}/__TRACE32_TOOLKIT_REL__/t32.py",
                "load"
            ],
            "presentation": {
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "T32: Start Debug Adapter",
            "detail": "Started automatically by TRACE32: Attach",
            "hide": true,
            "type": "process",
            "isBackground": true,
            "command": "__PYTHON_EXECUTABLE__",
            "args": [
                "${workspaceFolder}/__TRACE32_TOOLKIT_REL__/t32.py",
                "adapter"
            ],
            "presentation": {
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": [
                {
                    "owner": "trace32-adapter",
                    "pattern": {
                        "regexp": "^(ERROR):([^:]+):(\\d+):(.*)$",
                        "severity": 1,
                        "file": 2,
                        "line": 3,
                        "message": 4
                    },
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": "^.*starting DAP compatibility proxy.*$",
                        "endsPattern": "^\\[t32-dap-proxy\\] Listening on 127\\.0\\.0\\.1:__T32_DAP_PORT__.*$"
                    }
                }
            ]
        },
        {
            "label": "T32: RTT Viewer",
            "detail": "Interactive SEGGER RTT terminal over the running PowerView session",
            "type": "process",
            "command": "__PYTHON_EXECUTABLE__",
            "args": [
                "${workspaceFolder}/__TRACE32_TOOLKIT_REL__/t32.py",
                "rtt"
            ],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
