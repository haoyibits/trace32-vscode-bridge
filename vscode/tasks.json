{
    // Paths are relative to the workspace and assume the toolkit sits at
    // <workspace>/trace32_auto/. If you renamed or moved that directory,
    // update the three "command" entries below to match.
    //
    // BUILDING: not handled by the toolkit, on purpose - it does not care
    // whether the project is Rust, C or anything else. To rebuild before
    // flashing, uncomment the "dependsOn" below and put the label of your own
    // build task in it, e.g.:
    //
    //     "dependsOn": ["cargo build"],        // Rust
    //     "dependsOn": ["make"],               // C
    //
    // Define that task in this same file, or let it come from an extension
    // (rust-analyzer, CMake Tools, ...). "dependsOrder": "sequence" makes VS
    // Code wait for it to finish before flashing.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "T32: Flash + Debug",
            "detail": "Erase + program the ELF, load symbols, run, start the debug adapter",
            "type": "shell",
            "command": "${workspaceFolder}/trace32_auto/scripts/t32.sh",
            "args": [
                "flash"
            ],
            // "dependsOn": ["<your build task>"],
            "dependsOrder": "sequence",
            "presentation": {
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "T32: Load + Debug",
            "detail": "No flash: attach, load symbols of the existing ELF, start the debug adapter",
            "type": "shell",
            "command": "${workspaceFolder}/trace32_auto/scripts/t32.sh",
            "args": [
                "load"
            ],
            "presentation": {
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "T32: RTT Viewer",
            "detail": "Interactive SEGGER RTT terminal over the running PowerView session",
            "type": "shell",
            "command": "${workspaceFolder}/trace32_auto/scripts/t32.sh",
            "args": [
                "rtt"
            ],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
