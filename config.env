# ==============================================================================
# trace32-vscode-bridge - the only file you edit when moving to a new project.
#
# Syntax: KEY="value", one per line, comments on their own line.
# Values must not contain double quotes, and paths must not contain spaces
# (TRACE32 splits CMM arguments on whitespace).
# ==============================================================================


# ------------------------------------------------------------------------------
# Project
# ------------------------------------------------------------------------------

# Project root, relative to the directory holding this file (trace32-vscode-bridge/).
# Keep ".." when trace32-vscode-bridge/ sits directly in the project root. An absolute
# path works too.
PROJECT_ROOT=".."

# Basename of the ELF without extension. TRACE32 registers the symbol table
# under this name and the RTT viewer uses it to resolve the control block, so
# it must match the ELF filename.
PROGRAM_NAME="my_app"

# ELF to flash / load symbols from, relative to PROJECT_ROOT (or absolute).
#
# Building is not this toolkit's job - cargo, make, cmake, west, whatever the
# project uses stays the project's own concern. This is only the artifact to
# consume. To rebuild before flashing, chain the project's existing build task
# with "dependsOn" in .vscode/tasks.json; see the comment in there.
ELF="build/my_app.elf"


# ------------------------------------------------------------------------------
# Target
# ------------------------------------------------------------------------------

# Used when attaching. If the flash script wants a derivative name of its own,
# put CPU=<derivative> in T32_FLASH_ARGS below.
#
# Any of the next four can be left empty to skip the corresponding command,
# because not every architecture has it. TriCore in particular has no
# SYStem.MemAccess, so there T32_MEMACCESS must be empty.
T32_CPU="SR6P6"
T32_CORES="1."
T32_MEMACCESS="AXI"
T32_JTAG_CLOCK="10MHz"

# SYStem.Option.DUALPORT. Run-time memory access while the core keeps running,
# which is what the RTT viewer needs. Empty skips the command.
T32_DUALPORT="ON"

# Flash script. Empty means "RAM image, never flash".
#
# Any script following Lauterbach's PREPAREONLY convention works, which is
# nearly all of them (~770 of the 839 under ~~/demo/arm/flash). So for a
# different device this is usually the only line that changes:
#
#   T32_FLASH_SCRIPT="~~/demo/arm/flash/stm32f4xx.cmm"
#   T32_FLASH_SCRIPT="~~/demo/powerpc/flash/mpc5748g.cmm"
#
# "~~" is TRACE32's own installation directory. A path relative to
# trace32-vscode-bridge/ also works; see scripts/flash/README.md for when you need one.
T32_FLASH_SCRIPT="scripts/cmm/flash.cmm"

# Extra arguments for that script. PREPAREONLY is always passed and must not be
# repeated here. Check the header comment of your flash script for what it
# accepts.
T32_FLASH_ARGS="DUALPORT=1 JTAG_CLOCK=10MHz"


# ------------------------------------------------------------------------------
# TRACE32 installation
#
# The only absolute paths in this toolkit, and unavoidably so: TRACE32 is
# installed outside the project. Everything else is relative - project files to
# PROJECT_ROOT, flash scripts to "~~" (the TRACE32 installation) or to
# trace32-vscode-bridge/, and the scripts locate themselves from their own path.
#
# t32.sh sources this file with bash, so $HOME and other shell variables are
# expanded here. Prefer them over a literal /Users/... or /home/... so the file
# survives being copied to another machine. (Note that "~" alone does NOT
# expand inside quotes - write "$HOME" instead.)
# ------------------------------------------------------------------------------

# TRACE32 installation root: the directory containing bin/, demo/, config.t32.
# Can also be overridden per invocation:  T32SYS=/opt/t32 ./scripts/t32.sh load
T32_SYS="${T32SYS:-$HOME/t32}"

# Host subdirectory under $T32_SYS/bin. Empty auto-detects from `uname`
# (macosx64 on macOS, linux64 on Linux); set it explicitly on anything else.
T32_HOST=""

# PowerView executable for your core architecture:
#   t32marm-qt   ARM / Cortex        t32mtc-qt     TriCore / AURIX
#   t32mppc-qt   PowerPC             t32mriscv-qt  RISC-V
#   t32m2000-qt  TI C2000            (see $T32_SYS/bin/$T32_HOST for the rest)
T32_EXE="t32marm-qt"

# All three are derived from the keys above when left empty. Set one only if
# your installation does not follow the standard layout.
#   T32_BIN            -> $T32_SYS/bin/$T32_HOST/$T32_EXE
#   T32_REM            -> $T32_SYS/bin/$T32_HOST/t32rem
#   T32_DEBUG_ADAPTER  -> $T32_SYS/demo/env/vscode/bin/$T32_HOST/t32debugadapter
T32_BIN=""
T32_REM=""
T32_DEBUG_ADAPTER=""

# Config file passed to PowerView. Derived as $T32_SYS/config.t32 when empty.
T32_CONFIG=""

# Must match the "RCL=NETTCP / PORT=" section of config.t32.
T32_RCL_PORT="20000"

# DAP port between VS Code and t32debugadapter. Must match "debugServer" in
# .vscode/launch.json.
T32_DAP_PORT="58870"

# Internal port between the compatibility proxy and t32debugadapter. It must be
# different from T32_DAP_PORT and normally does not need changing.
T32_DAP_BACKEND_PORT="58871"

# Seconds the proxy waits for the raw t32debugadapter to start listening on the
# internal port. TRACE32 startup can take more than 10 seconds on some hosts.
T32_DAP_BACKEND_TIMEOUT="30"

# Node.js executable used for the DAP compatibility proxy. Empty means
# auto-detect `node` from PATH.
T32_NODE=""

# Seconds to wait for a TRACE32 script (flashing) to report back.
T32_TIMEOUT="600"


# ------------------------------------------------------------------------------
# RTT (SEGGER RTT over TRACE32 run-time memory access)
# ------------------------------------------------------------------------------

# Control-block symbol. Every stock SEGGER implementation uses _SEGGER_RTT.
RTT_SYMBOL="_SEGGER_RTT"

# Control-block address override, e.g. "0x20000000".
# Empty means "resolve it from the ELF symbols"
RTT_CB_ADDRESS=""
